
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  OPEN
  IN_REVIEW
  APPROVED
  COMPLETED
  REJECTED
}

enum RequestReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  DELIVERY_ISSUE
  OTHER
}

enum ResolutionType {
  REFUND
  REPLACEMENT
  STORE_CREDIT
}

enum NoteCategory {
  INTERNAL_UPDATE
  CUSTOMER_CONTACT
  DECISION
}

model ReturnRequest {
  id             String         @id @default(cuid())
  reference      String         @unique
  customerName   String
  customerEmail  String
  orderId        String
  itemId         String
  itemName       String
  reason         RequestReason
  description    String
  status         RequestStatus  @default(OPEN)

  resolutionType ResolutionType?
  refundAmount   Decimal?       @db.Decimal(12, 2)
  decisionAt     DateTime?
  decidedBy      String?

  isRemoved      Boolean        @default(false)
  removedAt      DateTime?
  removedBy      String?
  removalReason  String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notes          RequestNote[]

  @@index([status, isRemoved, createdAt])
  @@index([orderId, itemId])
  @@index([customerName])
  @@index([reason])
}

model RequestNote {
  id        String       @id @default(cuid())
  requestId String
  category  NoteCategory
  content   String
  author    String
  createdAt DateTime     @default(now())

  request   ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}
